# Copy to .env and fill in. Never commit .env.

# ── Database — Supabase (docs/mvp-plan.md §3) ────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
#   DATABASE_URL  "Transaction" pooler, port 6543, append ?pgbouncer=true — app runtime
#   DIRECT_URL    "Session" pooler, port 5432 — Prisma migrations only (DDL can't
#                 run through pgbouncer transaction pooling)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── HTTP ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# ── Sessions (server-side, no JWT — mvp-plan §3) ────────────────────────────
SESSION_COOKIE_NAME="veyra_session"
SESSION_TTL_HOURS=12
# openssl rand -hex 48
SESSION_SECRET=""

# ── Storage ────────────────────────────────────────────────────────────────
# `local` writes under STORAGE_LOCAL_ROOT. Switch to `s3` once the bucket
# exists and the S3 driver is uncommented (src/storage/s3-storage.service.ts).
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="storage"

# ── Background jobs ────────────────────────────────────────────────────────
# WORKERS_ENABLED=false to run the API without the outbox/reminder/digest cron
# (e.g. a second instance, or tests). MAILER_DRIVER: console logs each email;
# noop drops it. Resend is stubbed in mailer.service.ts.
WORKERS_ENABLED="true"
MAILER_DRIVER="console"
MAIL_FROM="Veyra <no-reply@veyra.example>"
# RESEND_API_KEY=""

# S3 (unused while STORAGE_DRIVER=local)
# S3_ENDPOINT=""
# S3_REGION="ap-south-1"
# S3_BUCKET="veyra-documents"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="true"
