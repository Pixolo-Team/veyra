{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --workspace @veyra/web",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm ci",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://veyra-api-695868445245.asia-south1.run.app/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
